{
  "name": "Nate's Theater",
  "short_name": "Theater",
  "description": "Your movies, shows, live TV and radio — and a remote for the car screen.",
  "start_url": "./#/remote",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
